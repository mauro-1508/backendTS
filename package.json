{
  "name": "signa-backend",
  "scripts": {
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.json",
    "start": "node dist/cmd/server/main.js",
    "test": "npm run build -w @traduce/shared && node scripts/run-tests.js",
    "dev": "nodemon --watch cmd --watch src --ext ts --exec ts-node cmd/server/main.ts",
    "dev:all": "concurrently -k -n gateway,lexicon,recognition \"npm run dev -w @traduce/api-gateway\" \"npm run dev -w @traduce/lexicon-service\" \"npm run dev -w @traduce/recognition-service\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.16",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.10",
    "@types/stream-json": "^1.7.8",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "stream-json": "^1.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "private": true
}
