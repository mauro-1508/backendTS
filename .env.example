# Referencia de TODAS las variables del backend, agrupadas por servicio con prefijo.
#
# Docker Compose: lee de este archivo (copiado a .env) solo JWT_SECRET, POSTGRES_PASSWORD,
#   EMAIL_USER y EMAIL_PASS; el resto lo define docker-compose.yml.
# Desarrollo local (npm run dev:all): cada servicio carga su propio services/<servicio>/.env
#   con los nombres SIN prefijo (p. ej. IAM_DB_HOST -> DB_HOST). Copia cada
#   services/<servicio>/.env.example y rellénalo con los valores de su sección.

# --- Comunes ---------------------------------------------------------------
# Mismo secreto en todos los servicios: iam firma los tokens y los demás los verifican.
JWT_SECRET=
POSTGRES_PASSWORD=postgres
# Vacío = eventos en memoria (sin RabbitMQ). Con docker compose: amqp://guest:guest@rabbitmq:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Vacío = muestras de gestos en memoria (sin MongoDB)
MONGO_URL=mongodb://localhost:27017/recognition

# --- api-gateway (:8080) ---------------------------------------------------
GATEWAY_PORT=8080
IAM_SERVICE_URL=http://localhost:3001
RECOGNITION_SERVICE_URL=http://localhost:3002
LEXICON_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004
PROFILE_SERVICE_URL=http://localhost:3005
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=300
GATEWAY_HEALTH_TIMEOUT_MS=2000

# --- iam-service (:3001) ---------------------------------------------------
IAM_PORT=3001
IAM_DB_HOST=localhost
IAM_DB_PORT=5433
IAM_DB_USER=postgres
IAM_DB_PASSWORD=
IAM_DB_NAME=iam
# Cuenta de Gmail que envía el código de recuperación de contraseña
EMAIL_USER=
EMAIL_PASS=

# --- recognition-service (:3002) ------------------------------------------
RECOGNITION_PORT=3002
RECOGNITION_DB_HOST=localhost
RECOGNITION_DB_PORT=5434
RECOGNITION_DB_USER=postgres
RECOGNITION_DB_PASSWORD=
RECOGNITION_DB_NAME=recognition

# --- lexicon-service (:3003) -----------------------------------------------
LEXICON_PORT=3003
LEXICON_DB_HOST=localhost
LEXICON_DB_PORT=5435
LEXICON_DB_USER=postgres
LEXICON_DB_PASSWORD=
LEXICON_DB_NAME=lexicon
# Directorio de medios (por defecto ./public/lexicon) y URL pública opcional (CDN)
LEXICON_MEDIA_DIR=
LEXICON_MEDIA_BASE_URL=

# --- analytics-service (:3004) ---------------------------------------------
ANALYTICS_PORT=3004
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5436
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_NAME=analytics

# --- profile-service (:3005) -----------------------------------------------
PROFILE_PORT=3005
PROFILE_DB_HOST=localhost
PROFILE_DB_PORT=5437
PROFILE_DB_USER=postgres
PROFILE_DB_PASSWORD=
PROFILE_DB_NAME=profile
