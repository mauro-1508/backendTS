PORT=3003
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=
DB_NAME=lexicon
# Mismo secreto que usa iam para firmar (HS256). Obligatorio, minimo 32 caracteres.
JWT_SECRET=
# Fuente de los roles para las rutas ADMIN:
#   none (por defecto) = deniega toda escritura con 403 y un mensaje claro
#   jwt                = lee el claim "roles" del token (requiere que iam lo emita)
ROLE_SOURCE=none
# Vacio = eventos en memoria (sin RabbitMQ). Ej: amqp://guest:guest@localhost:5672
RABBITMQ_URL=
# Directorio de medios (por defecto ./public/lexicon) y URL publica opcional (CDN)
LEXICON_MEDIA_DIR=
LEXICON_MEDIA_BASE_URL=
