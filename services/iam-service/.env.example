PORT=3001
DB_HOST=localhost
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=iam
# iam-service firma los tokens; el resto de servicios usan el mismo secreto solo para verificarlos
JWT_SECRET=
# Vacio = eventos en memoria (sin RabbitMQ)
RABBITMQ_URL=
# Cuenta de Gmail que envia el codigo de recuperacion de contrasena
EMAIL_USER=
EMAIL_PASS=
# Client IDs de OAuth de Google (web, Android, iOS) separados por comas. Vacio = POST /auth/google responde 503
GOOGLE_CLIENT_IDS=
# App de Facebook (developers.facebook.com). El secreto solo va aqui. Vacio = POST /auth/facebook responde 503
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
