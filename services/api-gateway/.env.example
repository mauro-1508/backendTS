PORT=8080
JWT_SECRET=
# URLs internas de los servicios
IAM_SERVICE_URL=http://localhost:3001
RECOGNITION_SERVICE_URL=http://localhost:3002
LEXICON_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004
PROFILE_SERVICE_URL=http://localhost:3005
# Rate limit por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
HEALTH_TIMEOUT_MS=2000
# Limite estricto por IP de login, forgot-password, verify-code y reset-password
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
# Origenes con permiso CORS, separados por comas (sin valor: Expo web en desarrollo, ninguno en produccion)
CORS_ORIGINS=
