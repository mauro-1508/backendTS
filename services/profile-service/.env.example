PORT=3005
DB_HOST=localhost
DB_PORT=5437
DB_USER=
DB_PASSWORD=
DB_NAME=profile
# Mismo secreto que iam-service: el servicio solo verifica los tokens
JWT_SECRET=
# Vacio = eventos en memoria (sin RabbitMQ)
RABBITMQ_URL=

# Resumenes y recordatorios IN_APP para administradores
RECOGNITION_URL=http://localhost:3002
ANALYTICS_URL=http://localhost:3004
# false = no arranca el planificador
ADMIN_REPORTS_ENABLED=true
# Cada cuanto revisa si toca enviar algo (ms)
ADMIN_REPORTS_TICK_MS=900000
